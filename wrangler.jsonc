{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govind-personal",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".claude/**",
      ".codex/**",
      ".impeccable/**"
    ]
  }
}
